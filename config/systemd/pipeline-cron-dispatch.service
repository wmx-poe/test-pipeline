[Unit]
Description=Pipeline cron dispatcher (OpenClaw agents only when jobs exist)
After=network-online.target
Wants=openclaw-gateway.service

[Service]
Type=oneshot
Environment=HOME=%h
Environment="PATH=%h/.local/node/bin:%h/.local/npm-global/bin:/usr/local/bin:/usr/bin:/bin"
# systemd EnvironmentFile 不支持 export 前缀；脚本内 load_env 会 source config/.env
ExecStart=%h/workspace/test-pipeline/scripts/cron-dispatch.sh

[Install]
WantedBy=default.target
