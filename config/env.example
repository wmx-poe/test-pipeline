# 复制为 config/.env 并填写（deploy.sh 会 source）
export PIPELINE_ROOT="/home/wmx/workspace/test-pipeline"

# OpenClaw / LLM — 代理站（OpenAI 兼容，见 config/openclaw.json5 中 models.providers.rayin）
export ANTHROPIC_BASE_URL="https://your-proxy.example.com/v1"
export ANTHROPIC_API_KEY=""
export OPENCLAW_DEFAULT_MODEL="rayin/gpt-5.3-codex"
# export OPENAI_API_KEY=""   # 飞书语音转写可复用 ANTHROPIC_API_KEY（deploy 会写入 OPENAI_API_KEY）

# 飞书开放平台 — 自建应用
export FEISHU_APP_ID=""
export FEISHU_APP_SECRET=""

# Google Stitch MCP（API Key 方式，无需 gcloud）
# 获取：https://stitch.withgoogle.com → 头像 → Stitch settings → Create key
export STITCH_API_KEY=""

# Claude Code CLI（agent-coder / agent-verifier 专用，与 OpenClaw ANTHROPIC_* 无关）
# DeepSeek 示例见 docs/CREDENTIALS.md §4
export CLAUDE_CODE_API_KEY=""
export CLAUDE_CODE_BASE_URL="https://api.deepseek.com/anthropic"
export CLAUDE_CODE_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_OPUS_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_SONNET_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_HAIKU_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_SUBAGENT_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_EFFORT_LEVEL="max"
# 兼容旧变量名（未设置上述 MODEL 时 deploy 会回退使用此项）
# export CLAUDE_CODE_DEFAULT_MODEL="deepseek-v4-pro[1m]"

# Codex CLI（可选，openai login 或 API key）
# export OPENAI_API_KEY=""

# 可选：飞书音频转写
# export OPENAI_API_KEY 已设置即可

# Gateway（onboard 会自动生成，也可手动）
# export OPENCLAW_GATEWAY_TOKEN=""
