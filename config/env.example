# 复制为 config/.env 并填写（deploy.sh 会 source）
export PIPELINE_ROOT="/home/wmx/workspace/test-pipeline"
export WORKSPACE_ROOT="/home/wmx/workspace/pipeline-workspace"

# 运维远程部署服务器（生产 VPS；IP 在此配置，不写死在 deploy-servers.json）
# 列表命令: PIPELINE_AGENT=manual ./scripts/deploy-servers-list.sh
export DEPLOY_SERVER_PROD_HOST="42.192.61.247"
export DEPLOY_SERVER_PROD_SSH_USER="root"
export DEPLOY_SERVER_PROD_ROOT="/opt/pipeline-apps"
# export DEPLOY_SERVER_PROD_NAME="生产 VPS"

# Agent 脚本边界门禁（1=开启，0=关闭）；见 docs/AGENT-BOUNDARIES.md
export PIPELINE_BOUNDARY_STRICT=1

# OpenClaw / LLM — DeepSeek（Anthropic 兼容端点，见 config/openclaw.json5 中 models.providers.deepseek）
# Rayin 备用（OpenAI 兼容 /v1）：取消注释下面三行，并注释掉 DeepSeek 三行；openclaw.json5 中同步切换 providers
# export ANTHROPIC_BASE_URL="https://code.rayinai.com/v1"
# export OPENCLAW_DEFAULT_MODEL="rayin/gpt-5.3-codex"
# export ANTHROPIC_API_KEY=""
export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
export ANTHROPIC_API_KEY=""
export OPENCLAW_DEFAULT_MODEL="deepseek/deepseek-v4-pro[1m]"
# Cron 扫描任务所用模型（deploy 会一并写入 OpenClaw agents.defaults.models 白名单）
# export OPENCLAW_CRON_MODEL_PRO="deepseek/deepseek-v4-pro[1m]"
# export OPENCLAW_CRON_MODEL_FLASH="deepseek/deepseek-v4-flash"
# export OPENAI_API_KEY=""   # 飞书语音转写可复用 ANTHROPIC_API_KEY（deploy 会写入 OPENAI_API_KEY）

# 飞书开放平台 — 自建应用
export FEISHU_APP_ID=""
export FEISHU_APP_SECRET=""

# Google Stitch MCP（API Key 方式，无需 gcloud）
# 获取：https://stitch.withgoogle.com → 头像 → Stitch settings → Create key
export STITCH_API_KEY=""

# Claude Code CLI（agent-coder / agent-verifier 专用，与 OpenClaw ANTHROPIC_* 无关）
# DeepSeek 示例见 docs/GUIDE.md 第八节
export CLAUDE_CODE_API_KEY=""
export CLAUDE_CODE_BASE_URL="https://api.deepseek.com/anthropic"
export CLAUDE_CODE_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_OPUS_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_SONNET_MODEL="deepseek-v4-pro[1m]"
export CLAUDE_CODE_DEFAULT_HAIKU_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_SUBAGENT_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_EFFORT_LEVEL="max"
# 以上 CLAUDE_CODE_* 由 deploy.sh 同步到 OpenClaw agents.defaults：
#   MODEL/OPUS/SONNET/HAIKU → models 白名单 + alias（/model opus|sonnet|haiku）
#   SUBAGENT_MODEL → subagents.model；EFFORT_LEVEL → params.thinking/effort
# 裸模型 ID 会自动加 deepseek/ 前缀
# 兼容旧变量名（未设置上述 MODEL 时 deploy 会回退使用此项）
# export CLAUDE_CODE_DEFAULT_MODEL="deepseek-v4-pro[1m]"

# Codex CLI（可选，openai login 或 API key）
# export OPENAI_API_KEY=""

# 可选：飞书音频转写
# export OPENAI_API_KEY 已设置即可

# Gateway（onboard 会自动生成，也可手动）
# export OPENCLAW_GATEWAY_TOKEN=""
